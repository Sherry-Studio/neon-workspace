# ─────────────────────────────────────────────────────────────
# NEON ARCADE ADMIN — Environment Variables
# Copy to `.env.local` and fill in real values. NEVER commit secrets.
# ─────────────────────────────────────────────────────────────

# The admin talks to the backend through its OWN same-origin proxy
# (`/api/admin/*`), which attaches the bearer token from the admin session.
# Keep this as "/api/admin" in every environment.
NEXT_PUBLIC_API_BASE_URL=/api/admin

# Backend API base URL as seen FROM THE ADMIN NEXT.JS SERVER (the proxy +
# session login route forward to this).
BACKEND_INTERNAL_URL=http://localhost:4000/api

# Human-readable environment label shown in the admin UI.
NEXT_PUBLIC_ENV_LABEL=local

# Secret used to sign the admin session cookie (the backend still issues its
# own JWTs — this only protects the cookie that carries them).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=dev_only_change_me_to_a_long_random_string_please
