# ─────────────────────────────────────────────────────────────
# NEON ARCADE ADMIN — Environment Variables
#
# Local:  copy to `admin/.env.local` and fill in.
# Vercel: set on the SEPARATE admin project (Root Directory = `admin`).
# NEVER commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────
# Signs the admin session cookie (the backend still issues its own JWTs).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=replace_me_with_a_long_random_string

# Backend API base URL as seen FROM THE ADMIN SERVER (the /api/admin proxy and
# the login route forward here). Point at the backend's public URL:
#   local  → http://localhost:4000/api
#   vercel → https://<your-services-project-domain>/api
BACKEND_INTERNAL_URL=http://localhost:4000/api

# ── Keep as-is ────────────────────────────────────────────
# The admin UI always talks to its own same-origin proxy.
NEXT_PUBLIC_API_BASE_URL=/api/admin

# ── Optional ──────────────────────────────────────────────
NEXT_PUBLIC_ENV_LABEL=production
