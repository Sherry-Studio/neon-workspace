# ─────────────────────────────────────────────────────────────
# NEON ARCADE BACKEND — Environment Variables
#
# Local:  copy to `backend/.env` and fill in.
# Vercel: set these on the "Services" project (Settings → Environment Variables).
#         NODE_ENV / VERCEL / VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL are
#         provided by Vercel automatically — do not set them.
# NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────
# MongoDB (use a production Atlas cluster + user for the live site)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/neon_arcade?retryWrites=true&w=majority

# JWT signing secrets — generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string

# ── Runtime (safe defaults; override only if you need to) ───
PORT=4000
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
RESET_TOKEN_TTL_MIN=30
VERIFY_TOKEN_TTL_MIN=1440

# ── CORS ───────────────────────────────────────────────────
# On Vercel, *.vercel.app and the project's production URL are auto-allowed.
# Only set these for a custom domain (comma-separated, no trailing slash).
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Cookies (only relevant for the long-running / local server) ──
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ── Seed admin (used by `npm run seed`) ────────────────────
SEED_ADMIN_USERNAME=neonadmin
SEED_ADMIN_EMAIL=admin@neonarcade.dev
SEED_ADMIN_PASSWORD=ChangeMe_Str0ng!Pass
SEED_DEMO_USERS=true

# ── Email (optional — password reset / verification) ───────
# If unset, links are logged instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="NEON ARCADE <no-reply@neonarcade.dev>"

# ── Image storage ─────────────────────────────────────────
# local    → writes to ./uploads   (dev / single persistent host only)
# cloudinary → REQUIRED on Vercel / any serverless host
STORAGE_PROVIDER=local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── API docs ──────────────────────────────────────────────
# Auto-disabled on Vercel regardless. Turn off in any production too.
SWAGGER_ENABLED=true
SWAGGER_ROUTE=/api/docs

# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ── Firebase Cloud Messaging (optional — web push; see README) ──
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
