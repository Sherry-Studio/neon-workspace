# ─────────────────────────────────────────────────────────────
# NEON ARCADE BACKEND — Environment Variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/neon_arcade

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Password reset / email verification token lifetime (minutes)
RESET_TOKEN_TTL_MIN=30
VERIFY_TOKEN_TTL_MIN=1440

# CORS — comma-separated list of allowed origins
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Cookies
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Seed admin (used by `npm run seed`) — change before running in production
SEED_ADMIN_USERNAME=neonadmin
SEED_ADMIN_EMAIL=admin@neonarcade.dev
SEED_ADMIN_PASSWORD=ChangeMe_Str0ng!Pass
SEED_DEMO_USERS=true

# Email (SMTP) — optional; if unset, verification/reset links are logged to console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="NEON ARCADE <no-reply@neonarcade.dev>"

# Storage provider for images: local | cloudinary | s3
# NOTE: `local` needs a writable disk and won't work on serverless (Vercel) —
# use `cloudinary` there.
STORAGE_PROVIDER=local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads

# Cloudinary (when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 (when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Firebase Cloud Messaging (optional — push notifications)
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# API docs
SWAGGER_ENABLED=true
SWAGGER_ROUTE=/api/docs

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
