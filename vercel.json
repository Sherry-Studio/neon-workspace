{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/server.ts",
      "buildCommand": "echo 'skip build — @vercel/node bundles src/server.ts directly'"
    }
  },
  "rewrites": [
    { "source": "/api/auth/(.*)", "destination": { "service": "frontend" } },
    { "source": "/api/profile", "destination": { "service": "frontend" } },
    { "source": "/api/gateway/(.*)", "destination": { "service": "frontend" } },
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
